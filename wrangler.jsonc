/**
 * Xero MCP — Cloudflare Workers configuration
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "xero-mcp",
	"main": "src/index.ts",
	"compatibility_date": "2025-03-10",
	"compatibility_flags": ["nodejs_compat"],
	/**
	 * Secrets (never commit real values):
	 *   npx wrangler secret put XERO_CLIENT_ID
	 *   npx wrangler secret put XERO_CLIENT_SECRET
	 *   npx wrangler secret put COOKIE_ENCRYPTION_KEY
	 *
	 * Local: copy .dev.vars.example → .dev.vars
	 */
	"migrations": [
		{
			"new_sqlite_classes": ["XeroMCP"],
			"tag": "v1"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "XeroMCP",
				"name": "MCP_OBJECT"
			}
		]
	},
	"kv_namespaces": [
		{
			"binding": "OAUTH_KV",
			"id": "bbf1e4988d3449fe908e9a6eb348bb39",
			"preview_id": "f9001b0bb1374055a8e1de68197e83d3"
		}
	],
	"observability": {
		"enabled": true
	},
	"dev": {
		"port": 8788
	},
	"vars": {
		"MCP_SERVER_NAME": "xero-mcp",
		"XERO_AUTH_MODE": "web"
	}
}
